# RMMT 전용 환경설정: 일정은 한국시간(KST) 기준이며 설정 변경은 재시작 후 적용됩니다. 비밀값을 공개하지 마세요.

# 전략 유형: reverse=과거 수익률 낮은 순(역모멘텀), momentum=높은 순(모멘텀). momentum은 DB 파일명 앞에 momentum_을 자동 적용합니다.
# 입력 가능: reverse(역모멘텀) / momentum(모멘텀), 대소문자 허용. momentum은 DB 파일명에 momentum_ 자동 적용.
STRATEGY=reverse

# 선정 대상 시장(자료 수집은 코스피·코스닥 전체): KOSDAQ(코스닥), KOSPI(코스피), COMBINED(두 시장 통합). 통합은 합친 전체 보통주의 시총으로 십분위를 계산합니다.
# 입력 가능: KOSDAQ / KOSPI / COMBINED, 대소문자 허용.
MARKET=KOSDAQ

# 시총 십분위: KIS 명부 시총 사용(하루 정도 차이 허용), 동률은 난수로 분류. 0=전체, 1=최소, 10=최대; 0~10 정수.
# 입력 가능: 0~10 정수. 0=전체, 1=최소 시총, 10=최대 시총.
DECILE=1

# 포메이션 끝과 가격 기준일 사이의 건너뛰기 기간: 현재 0만 지원하며 직전 거래일 종가까지 사용합니다.
# 입력 가능: 0만 지원(고정값).
SKIP=0

# 목표 선정 종목 수: 양의 정수로 설정하며 상한은 없습니다. 기본값은 20개이고 적격 종목이 부족하면 실제 선정 수로 균등 배분합니다.
# 입력 가능: 1 이상 정수(종목 수), 별도 상한 없음.
HOLDINGS=20

# 전략 일정의 기준 시간대: Asia/Seoul(한국시간)입니다.
# 입력 가능: Asia/Seoul만 지원(고정값).
TIMEZONE=Asia/Seoul

# 두 전략 공통 증분 수집 시작 시각(KST, HH:MM): 09:00~15:00. 수집·검증·선정·매도·매수를 순서대로 수행하며 30분 뒤 주문창 종료.
# 입력 가능: 09:00~15:00의 HH:MM(KST). 두 전략 공통, 주문창은 시작부터 30분.
REVERSE_EXECUTION_TIME=10:00

# 주문창 길이(분): 현재 30분만 지원하며 설정한 시작 시각에서 30분 뒤 잔량 취소를 요청합니다.
# 입력 가능: 30만 지원(고정값).
EXECUTION_WINDOW_MINUTES=30

# 늦은 시작 정책: WITHIN_WINDOW_ONLY는 주문창 안에서만 최초 실행을 허용합니다.
# 입력 가능: WITHIN_WINDOW_ONLY만 지원(고정값).
LATE_START_POLICY=WITHIN_WINDOW_ONLY

# 두 전략 공통 투자상한(만원 단위 양의 정수); 1000=1,000만원. 기존 키 이름을 유지하며 재시작 시 원장 상한에 반영, 현금·초기자산·보유수량은 유지.
# 입력 가능: 1 이상 정수(만원 단위). 예: 1000=1,000만원. 두 전략 공통.
REVERSE_MOMENTUM_CAPITAL_MANWON=1000

# 자본 운용 정책: FIXED_CAP은 수익이 나도 설정 투자상한을 유지합니다.
# 입력 가능: FIXED_CAP만 지원(고정값).
CAPITAL_POLICY=FIXED_CAP

# 직전 거래일(신호 가격 기준일) 명목종가의 최소 허용 가격(원)입니다.
# 입력 가능: 0보다 큰 유한한 숫자(원 단위).
MIN_PRICE=1000

# 보유종목을 0원 평가하는 연속 무거래 시장거래일 수: 현재 5일입니다. 실제 수량은 유지합니다.
# 입력 가능: 5만 지원(고정값).
NO_TRADE_DAYS=5

# 급변 관찰 기준(%): 포메이션 구간 내부의 연속 가격 변동률 절댓값이 현재 35를 초과할 때입니다.
# 입력 가능: 35만 지원(고정값).
PERSISTENT_JUMP_PCT=35

# 매수 수수료 추정 비율: 0.00015는 0.015%입니다. 실제 비용 확인 후 차액을 조정합니다.
# 입력 가능: 0 이상 0.1 미만의 비율. 예: 0.00015=0.015%.
BUY_FEE=0.00015

# 매도 수수료 추정 비율: 0.00015는 0.015%입니다. 실제 비용 확인 후 차액을 조정합니다.
# 입력 가능: 0 이상 0.1 미만의 비율. 예: 0.00015=0.015%.
SELL_FEE=0.00015

# 매도세 추정 비율: 0.002는 0.2%입니다. 실제 비용 확인 후 차액을 조정합니다.
# 입력 가능: 0 이상 0.1 미만의 비율. 예: 0.002=0.2%.
SELL_TAX=0.002

# 주문 방식: MARKET은 시장가, LIMIT은 지정가입니다.
# 입력 가능: MARKET(시장가) / LIMIT(현재가 지정가), 대소문자 허용.
ORDER_POLICY=MARKET

# 지정가 정책: CURRENT_NO_CHASE는 최초 현재가로 주문하고 추격 없이 주문창 종료 시 잔량을 취소합니다.
# 입력 가능: CURRENT_NO_CHASE(지원 지정가 정책) / UNRESOLVED(미확정). LIMIT 브로커 주문은 CURRENT_NO_CHASE만 지원.
LIMIT_POLICY=CURRENT_NO_CHASE

# 지속 급변 처리: 포메이션 구간에서 확정되면 신규 매수 제외·다음 리밸런싱 매도하며 구간 이전 급변은 승계하지 않습니다.
# 입력 가능: EXCLUDE_EXIT_REBALANCE(급변 제외·리밸런싱 청산) / UNRESOLVED(미확정, 브로커 주문 차단).
SHOCK_POLICY=EXCLUDE_EXIT_REBALANCE

# 배당 운용 정책: RETAIN은 확인된 RMMT 귀속 배당을 전략 현금에 유지합니다.
# 입력 가능: RETAIN(귀속 배당 현금 유지) / UNRESOLVED(미확정, 브로커 주문 차단).
DIVIDEND_POLICY=RETAIN

# 세부 전략 설계 승인 확인: true여야 브로커 주문 모드를 사용할 수 있습니다. 실거래 승인과는 별개입니다.
# 입력 가능: true / false, 대소문자 허용.
DESIGN_APPROVED=true

# 실행 모드: DRY_RUN은 주문 없음, PAPER는 자체 모의체결, LIVE는 실거래입니다. 현재 DEMO 주문 실행은 차단됩니다.
# 입력 가능: DRY_RUN(주문 없음) / PAPER(자체 모의체결) / DEMO(KIS 모의, 현재 주문 실행 미지원) / LIVE(실거래), 대소문자 허용.
RUN_MODE=DRY_RUN

# 실거래 활성화 여부: 별도 승인 후에만 true로 변경합니다. LIVE 모드와 다른 안전 조건도 함께 충족해야 합니다.
# 입력 가능: true / false, 대소문자 허용.
RMMT_LIVE_ENABLED=false

# KIS 접속 환경: real은 실전 서버, demo는 모의 서버입니다.
# 입력 가능: real(실전 서버) / demo(모의 서버). LIVE는 real, DEMO는 demo 필요.
KIS_ENV=real

# KIS 실전 API 앱키(비밀정보): 로그와 보고서에 출력하지 않습니다.
# 입력 가능: KIS에서 발급받은 비밀 문자열 또는 빈 문자열. 해당 서버에 실제 접속할 때 필수.
KIS_REAL_APP_KEY=

# KIS 실전 API 앱시크릿(비밀정보): 로그와 보고서에 출력하지 않습니다.
# 입력 가능: KIS에서 발급받은 비밀 문자열 또는 빈 문자열. 해당 서버에 실제 접속할 때 필수.
KIS_REAL_APP_SECRET=

# KIS 실전 계좌번호(비밀정보): 앞 8자리 계좌번호와 뒤 2자리 상품코드를 설정합니다.
# 입력 가능: 계좌번호 8자리 숫자 또는 8자리-2자리/연속 10자리 형식. 해당 서버에 접속할 때 필수, 비밀값은 그대로 유지.
KIS_REAL_ACCOUNT=

# KIS 모의 API 앱키(비밀정보): 로그와 보고서에 출력하지 않습니다.
# 입력 가능: KIS에서 발급받은 비밀 문자열 또는 빈 문자열. 해당 서버에 실제 접속할 때 필수.
KIS_DEMO_APP_KEY=

# KIS 모의 API 앱시크릿(비밀정보): 로그와 보고서에 출력하지 않습니다.
# 입력 가능: KIS에서 발급받은 비밀 문자열 또는 빈 문자열. 해당 서버에 실제 접속할 때 필수.
KIS_DEMO_APP_SECRET=

# KIS 모의 계좌번호(비밀정보): 앞 8자리 계좌번호와 뒤 2자리 상품코드를 설정합니다.
# 입력 가능: 계좌번호 8자리 숫자 또는 8자리-2자리/연속 10자리 형식. 해당 서버에 접속할 때 필수, 비밀값은 그대로 유지.
KIS_DEMO_ACCOUNT=

# KIS 계좌 상품코드: 값이 있으면 계좌번호 뒤 2자리보다 우선하며 일반 위탁계좌는 보통 01입니다.
# 입력 가능: 2자리 숫자 상품코드(일반 위탁 예: 01) 또는 빈 문자열(계좌 뒤 2자리, 없으면 01 사용).
KIS_ACCOUNT_PRODUCT_CODE=01

# RMMT의 KIS REST 요청 사이 최소 간격(초)입니다.
# 입력 가능: 0보다 큰 유한한 숫자(초 단위, 소수 허용).
KIS_REST_MIN_INTERVAL_SECONDS=0.2

# 주문창 안의 체결 확인 및 서비스 점검 간격(초)입니다.
# 입력 가능: 0보다 큰 유한한 숫자(초 단위, 소수 허용).
POLL_SECONDS=3

# 주문 판단에 사용할 현재가의 최대 허용 경과시간(초)입니다.
# 입력 가능: 1 이상 정수(초 단위).
QUOTE_MAX_AGE_SECONDS=30

# 매수 판단에 사용할 경고 상태 자료의 최대 허용 경과시간(초)입니다.
# 입력 가능: 1 이상 정수(초 단위).
STATUS_MAX_AGE_SECONDS=60

# 계좌 운용 정책: SHARED_OWNED_ONLY는 양 전략이 자기 귀속수량만 매도하는 동일 계좌 병행 정책입니다.
# 입력 가능: SEPARATE / BCSO_STOPPED / SHARED_OWNED_ONLY / UNRESOLVED / DEFERRED. LIVE는 앞의 세 정책과 각 확인 조건 충족 필요.
ACCOUNT_POLICY=SHARED_OWNED_ONLY

# BCSO_STOPPED 계좌 정책을 선택했을 때 BCSO의 실제 중지 완료 확인값입니다.
# 입력 가능: true / false, 대소문자 허용.
BCSO_STOP_CONFIRMED=false

# 기존 BCSO 계좌 지문 생성용 비밀값입니다. 계좌 분리 확인에 사용하며 임의 변경하지 않습니다.
# 입력 가능: 빈 문자열 또는 계좌 지문 생성용 비밀 문자열. SEPARATE 확인에는 정상 salt와 hash 모두 필요.
BCSO_REFERENCE_ACCOUNT_SALT=

# 기존 BCSO 계좌의 보호된 지문입니다. 계좌 분리 확인에 사용하며 임의 변경하지 않습니다.
# 입력 가능: 빈 문자열 또는 계좌 지문의 HMAC-SHA256 16진수 문자열(정상 형식 64자). SEPARATE 확인에 사용.
BCSO_REFERENCE_ACCOUNT_HASH=

# BCSO가 자기 귀속수량만 매도하도록 수정된 사실의 확인값입니다. 사용자가 수정 완료를 확인한 후에만 true로 변경합니다.
# 입력 가능: true / false, 대소문자 허용.
BCSO_OWNERSHIP_FIX_CONFIRMED=false

# 급변 이후 지속 여부를 확인할 유효 실제 거래 관측 수: 현재 5회입니다.
# 입력 가능: 5만 지원(고정값).
SHOCK_OBSERVATIONS=5

# 원본 자료·스냅샷·이력 캐시를 저장할 기본 데이터 폴더입니다. RMMT 폴더 안의 경로만 허용합니다.
# 입력 가능: 프로젝트 폴더 안의 상대/절대 폴더 경로. 프로젝트 밖 경로는 허용하지 않음.
RMMT_DATA_DIR=rmmt/data

# 실행별 CSV·JSON 보고서를 저장할 기본 결과 폴더입니다.
# 입력 가능: 프로젝트 폴더 안의 상대/절대 폴더 경로. 프로젝트 밖 경로는 허용하지 않음.
RMMT_RESULTS_DIR=rmmt/results

# 공식 시장거래일 달력 JSON 파일 경로입니다.
# 입력 가능: 프로젝트 폴더 안의 상대/절대 파일 경로. 프로젝트 밖 경로는 허용하지 않음.
CALENDAR_PATH=rmmt/data/calendar.json

# 예정 거래일 설정 시각 선정 결과의 입력 스냅샷 JSON 경로: 가격 기준일은 직전 거래일이며 시총은 KIS 명부 제공 값을 사용합니다.
# 입력 가능: 프로젝트 폴더 안의 상대/절대 파일 경로. 프로젝트 밖 경로는 허용하지 않음.
SIGNAL_SNAPSHOT_PATH=rmmt/data/signal_latest.json

# 최신 완료 거래일의 보유종목 평가 입력 JSON 파일 경로입니다.
# 입력 가능: 프로젝트 폴더 안의 상대/절대 파일 경로. 프로젝트 밖 경로는 허용하지 않음.
DAILY_SNAPSHOT_PATH=rmmt/data/daily_latest.json

# 계획·자체 모의체결에 사용할 현재가 JSON 파일 경로입니다. 기본 예시는 합성 자료입니다.
# 입력 가능: 프로젝트 폴더 안의 상대/절대 파일 경로. 프로젝트 밖 경로는 허용하지 않음.
QUOTE_SNAPSHOT_PATH=rmmt/data/examples/synthetic_quotes.json

# DRY_RUN 원장 기준 경로: reverse는 그대로, momentum은 파일명 앞에 momentum_ 자동 적용(--db 우선).
# 입력 가능: 프로젝트 폴더 안의 상대/절대 파일 경로. 프로젝트 밖 경로는 허용하지 않음. momentum은 파일명 앞에 momentum_ 자동 적용(이미 있으면 유지), --db 우선.
DRY_RUN_DB_PATH=rmmt/data/dry_run.sqlite

# PAPER 원장 기준 경로: reverse는 그대로, momentum은 파일명 앞에 momentum_ 자동 적용(--db 우선).
# 입력 가능: 프로젝트 폴더 안의 상대/절대 파일 경로. 프로젝트 밖 경로는 허용하지 않음. momentum은 파일명 앞에 momentum_ 자동 적용(이미 있으면 유지), --db 우선.
PAPER_DB_PATH=rmmt/data/paper.sqlite

# DEMO 원장 기준 경로: momentum은 파일명 앞에 momentum_ 자동 적용. 현재 DEMO 주문 실행 미지원.
# 입력 가능: 프로젝트 폴더 안의 상대/절대 파일 경로. 프로젝트 밖 경로는 허용하지 않음. momentum은 파일명 앞에 momentum_ 자동 적용(이미 있으면 유지), --db 우선.
DEMO_DB_PATH=rmmt/data/demo.sqlite

# LIVE 원장 기준 경로: reverse는 그대로, momentum은 momentum_live.sqlite 자동 선택(--db 우선). 이미 momentum_으로 시작하면 유지.
# 입력 가능: 프로젝트 폴더 안의 상대/절대 파일 경로. 프로젝트 밖 경로는 허용하지 않음. momentum은 파일명 앞에 momentum_ 자동 적용(이미 있으면 유지), --db 우선.
LIVE_DB_PATH=rmmt/data/live.sqlite

# API가 발급한 실전 접속 토큰의 RMMT 전용 캐시 경로입니다. 파일 권한은 0600으로 관리합니다.
# 입력 가능: 프로젝트 폴더 안의 상대/절대 파일 경로. 프로젝트 밖 경로는 허용하지 않음.
KIS_REAL_TOKEN_CACHE_PATH=rmmt/data/.kis_token_real.json

# API가 발급한 모의 접속 토큰의 RMMT 전용 캐시 경로입니다. 파일 권한은 0600으로 관리합니다.
# 입력 가능: 프로젝트 폴더 안의 상대/절대 파일 경로. 프로젝트 밖 경로는 허용하지 않음.
KIS_DEMO_TOKEN_CACHE_PATH=rmmt/data/.kis_token_demo.json

# 호환용 설정(현재 서비스에서는 미사용): 예정 리밸런싱 시각의 증분 수집은 이 값과 관계없이 수행합니다.
# 입력 가능: true / false, 대소문자 허용.
SERVICE_AUTO_COLLECT=true

# 설정한 주문창 이외의 서비스 반복 대기시간(초)입니다.
# 입력 가능: 0보다 큰 유한한 숫자(초 단위, 소수 허용).
SERVICE_IDLE_SECONDS=30

# 서비스 오류가 발생한 뒤 다음 점검 전에 추가로 기다릴 시간(초)입니다.
# 입력 가능: 0보다 큰 유한한 숫자(초 단위, 소수 허용).
SERVICE_ERROR_RETRY_SECONDS=15

# HTTP 연결 수립 제한시간(초)입니다.
# 입력 가능: 0보다 큰 유한한 숫자(초 단위, 소수 허용).
HTTP_CONNECT_TIMEOUT_SECONDS=5

# KIS REST 조회·주문 응답 및 토큰 발급 응답의 읽기 제한시간(초)입니다.
# 입력 가능: 0보다 큰 유한한 숫자(초 단위, 소수 허용).
KIS_REQUEST_TIMEOUT_SECONDS=20

# 공개 종목 마스터 응답의 읽기 제한시간(초)입니다. Yahoo는 실전 수집에서 사용하지 않습니다.
# 입력 가능: 0보다 큰 유한한 숫자(초 단위, 소수 허용).
PUBLIC_DATA_TIMEOUT_SECONDS=30

# KIS 주문 본문 해시 발급 응답의 읽기 제한시간(초)입니다.
# 입력 가능: 0보다 큰 유한한 숫자(초 단위, 소수 허용).
KIS_HASH_TIMEOUT_SECONDS=15

# 토큰 만료 전에 갱신 필요 상태로 판단할 여유시간(초)입니다.
# 입력 가능: 1 이상 정수(초 단위).
KIS_TOKEN_EXPIRY_MARGIN_SECONDS=60

# 토큰 발급 재시도 사이 최소 대기시간(초): 60초 이상이어야 합니다.
# 입력 가능: 60 이상 정수(초 단위).
KIS_TOKEN_ISSUE_COOLDOWN_SECONDS=60

# KIS 공식 종목 마스터를 재사용할 최대 캐시 시간(초)입니다.
# 입력 가능: 1 이상 정수(초 단위).
KIS_MASTER_CACHE_SECONDS=45

# 계좌·주문 연속조회에서 허용할 최대 페이지 수입니다. 초과 시 불완전 자료 사용을 중단합니다.
# 입력 가능: 1 이상 정수(페이지 단위).
KIS_ACCOUNT_MAX_PAGES=100

# 종목별 과거 일봉 이력 조회에서 허용할 최대 페이지 수입니다.
# 입력 가능: 1 이상 정수(페이지 단위).
KIS_HISTORY_MAX_PAGES=500

# KIS 원주가 증분 캐시의 중첩 구간(달력일)입니다. 수정주가는 새 기준일에 필요한 F+1 구간을 재조회합니다.
# 입력 가능: 1 이상 정수(달력일 단위).
KIS_HISTORY_OVERLAP_DAYS=10

# 원주가 캐시의 증분 갱신 최대 간격(달력일)입니다. 초과 시 필요한 포메이션 구간을 다시 조회합니다.
# 입력 가능: 1 이상 정수(달력일 단위).
KIS_HISTORY_CACHE_MAX_GAP_DAYS=100

# 시총·이력 수집의 진행 알림 간격(종목 수) 및 달력 수집의 진행 알림 간격(조회 날짜 수)입니다.
# 입력 가능: 1 이상 정수(종목/조회 날짜 수 단위).
COLLECTION_PROGRESS_INTERVAL=100

# 한 번에 공식 달력을 수집할 수 있는 시작일·종료일 간 최대 간격(달력일)입니다.
# 입력 가능: 1 이상 정수(달력일). BOOTSTRAP_CALENDAR_PAST_DAYS+BOOTSTRAP_CALENDAR_FUTURE_DAYS 이상 필요.
CALENDAR_MAX_RANGE_DAYS=2000

# 수동 collect 명령의 당일 자료 조회 허용 시각(HH:MM, KST). 서비스의 16시 자동 수집은 제거되었습니다.
# 입력 가능: 00:00~23:59의 HH:MM(KST), 예: 16:00. 예정 리밸런싱의 직전 거래일 증분 수집에는 적용하지 않음.
DATA_READY_TIME=16:00

# 선택적 실전 계좌 비밀번호(비밀정보): 현재 KIS REST 구현에서는 사용하거나 전송하지 않습니다.
# 입력 가능: 빈 문자열 또는 사용자 비밀 문자열(선택 항목, 현재 REST 구현 미사용).
KIS_REAL_ACCOUNT_PASSWORD=

# 선택적 모의 계좌 비밀번호(비밀정보): 현재 KIS REST 구현에서는 사용하거나 전송하지 않습니다.
# 입력 가능: 빈 문자열 또는 사용자 비밀 문자열(선택 항목, 현재 REST 구현 미사용).
KIS_DEMO_ACCOUNT_PASSWORD=

# 선택적 KIS 실전 HTS 사용자 ID: 현재 REST 구현에서는 사용하거나 전송하지 않습니다.
# 입력 가능: 빈 문자열 또는 사용자 비밀 문자열(선택 항목, 현재 REST 구현 미사용).
KIS_REAL_HTS_ID=

# 선택적 KIS 모의 HTS 사용자 ID: 현재 REST 구현에서는 사용하거나 전송하지 않습니다.
# 입력 가능: 빈 문자열 또는 사용자 비밀 문자열(선택 항목, 현재 REST 구현 미사용).
KIS_DEMO_HTS_ID=

# 관리종목 제외 여부: true는 제외 적용, false는 이 경고 자체로는 제외하지 않음입니다.
# 입력 가능: true / false, 대소문자 허용.
EXCLUDE_REGULATORY_MANAGED=true       # 관리종목

# 투자주의환기종목 제외 여부: true는 제외 적용, false는 이 경고 자체로는 제외하지 않음입니다.
# 입력 가능: true / false, 대소문자 허용.
EXCLUDE_REGULATORY_CAUTIONARY=true    # 투자주의환기종목

# 투자주의종목 제외 여부: true는 제외 적용, false는 이 경고 자체로는 제외하지 않음입니다.
# 입력 가능: true / false, 대소문자 허용.
EXCLUDE_REGULATORY_CAUTION=true       # 투자주의종목

# 투자경고종목 제외 여부: true는 제외 적용, false는 이 경고 자체로는 제외하지 않음입니다.
# 입력 가능: true / false, 대소문자 허용.
EXCLUDE_REGULATORY_WARNING=true       # 투자경고종목

# 투자위험종목 제외 여부: true는 제외 적용, false는 이 경고 자체로는 제외하지 않음입니다.
# 입력 가능: true / false, 대소문자 허용.
EXCLUDE_REGULATORY_RISK=true          # 투자위험종목

# 운영 상태와 주문 상태 변경 및 오류 기록 경로
# 입력 가능: 프로젝트 폴더 안의 상대/절대 파일 경로. 프로젝트 밖 경로는 허용하지 않음. 세 로그 경로는 서로 달라야 함.
SYSTEM_LOG_PATH=rmmt/logs/system.log

# 확정 체결과 비용 정정 CSV 기록 경로; 전체 이력 유지
# 입력 가능: 프로젝트 폴더 안의 상대/절대 파일 경로. 프로젝트 밖 경로는 허용하지 않음. 세 로그 경로는 서로 달라야 함.
TRADING_LOG_PATH=rmmt/logs/trading.log

# 화면 출력 및 상세 JSON 진단 기록 경로: 상세 JSON은 대시보드에서 생략해도 파일에는 남습니다.
# 입력 가능: 프로젝트 폴더 안의 상대/절대 파일 경로. 프로젝트 밖 경로는 허용하지 않음. 세 로그 경로는 서로 달라야 함.
SCREEN_LOG_PATH=rmmt/logs/screen.log

# system 및 screen 로그의 파일당 최대 바이트; 초과 시 회전
# 입력 가능: 1 이상 정수(바이트 단위).
LOG_MAX_BYTES=10485760

# system 및 screen 로그별 이전 파일 보관 개수
# 입력 가능: 1 이상 정수(파일 단위).
LOG_BACKUP_COUNT=5

# 터미널 대시보드 표시 여부: true는 필요한 상태·알림 중심 화면, false는 명령의 JSON 출력을 사용합니다.
# 입력 가능: true / false, 대소문자 허용.
DASHBOARD_ENABLED=true

# 대시보드의 일반 갱신 간격(초): 상태 변경·수집 진행 알림은 즉시 갱신할 수 있습니다.
# 입력 가능: 0보다 큰 유한한 숫자(초 단위, 소수 허용).
DASHBOARD_REFRESH_SECONDS=3

# 대시보드에 표시할 최근 중요 알림의 최대 줄 수: 반복 대기는 생략하고 진행률은 최신 값으로 갱신합니다.
# 입력 가능: 1 이상 정수(줄 단위).
DASHBOARD_RECENT_LINES=10

# 과거 달력 확보의 기본 일수(달력일, 최소 60): 포메이션 길이와 리밸런싱 기준일에 맞춰 실제 조회 범위를 늘립니다.
# 입력 가능: 60 이상 정수(달력일). 과거+미래 일수 합은 CALENDAR_MAX_RANGE_DAYS 이하.
BOOTSTRAP_CALENDAR_PAST_DAYS=120

# 미래 달력 확보의 기본 일수(달력일, 최소 14): 리밸런싱 간격에 맞춰 실제 조회 범위를 늘립니다.
# 입력 가능: 14 이상 정수(달력일). 과거+미래 일수 합은 CALENDAR_MAX_RANGE_DAYS 이하.
BOOTSTRAP_CALENDAR_FUTURE_DAYS=45

# 호환용 과거 준비 상태 파일 경로(현재 서비스에서는 읽거나 쓰지 않음). 기존 파일은 보존합니다.
# 입력 가능: 프로젝트 폴더 안의 상대/절대 파일 경로. 프로젝트 밖 경로는 허용하지 않음.
PREPARATION_STATE_PATH=rmmt/data/preparation_state.json

# 포메이션 수익률 계산 간격(거래일, 정수 5~252): 1주=5, 1개월=21, 1년=252. 종가 자료는 설정값+1개가 필요하며 대상·보유종목의 해당 구간만 KIS에서 조회합니다. 수정주가는 새 기준일에 이 구간 전체를 갱신합니다. 필요한 자료 누락은 재조회하고 형성이력 부족 상장종목은 제외합니다.
# 입력 가능: 5~252 정수(시장 거래일). 예: 5=1주, 21=약 1개월, 252=약 1년. 종가 F+1개 필요.
FORMATION_DAYS=21

# 선정·리밸런싱 주기: 1D/2D=거래일 간격(매년 첫 거래일부터), 1W/2W=월요일 기준 주간, 1M/2M=월초, 1Y=연초. 휴장은 기간의 첫 개장일로 순연합니다. 최대 252D/52W/12M/1Y.
# 입력 가능: 1~252D / 1~52W / 1~12M / 1Y, 정수 뒤 단위 필수·대소문자 허용. 예: 1D, 2D, 1W, 2W, 1M, 2M, 1Y.
REBALANCE_DAYS=1W


# 대시보드 표시용 가상 보유: false로 바꾸면 제거합니다. 실제 원장·매매·전략손익에는 반영하지 않습니다.
# 입력 가능: true / false, 대소문자 허용.
PREVIEW_HOLDING_ENABLED=false

# 표시용 가상 보유 종목코드
# 입력 가능: 6자리 숫자 종목코드 문자열. 앞자리 0 유지, 예: 005930.
PREVIEW_HOLDING_SYMBOL=005930

# 표시용 가상 보유 종목명
# 입력 가능: 표시용 종목명 문자열. 예: 삼성전자.
PREVIEW_HOLDING_NAME=삼성전자

# 표시용 가상 보유 수량(주)
# 입력 가능: 1 이상 정수(주 단위).
PREVIEW_HOLDING_QUANTITY=10

# 표시용 가상 보유 평단 및 평가가격(원)
# 입력 가능: 0보다 큰 유한한 숫자(원 단위, 가상 평단).
PREVIEW_HOLDING_PRICE=271500

# 보유·선정·가상 종목의 대시보드 현재가 REST 조회 최소 간격(초): 웹소켓이 아닌 주기 조회이며 조회량에 따라 지연될 수 있습니다.
# 입력 가능: 0보다 큰 유한한 숫자(초 단위, 소수 허용).
DASHBOARD_QUOTE_REFRESH_SECONDS=5

# 추가 화면 표시용 가상 보유: 코드,이름,수량,가상평단(원); 종목 간 세미콜론 구분. 실제 매매·원장·손익에 반영하지 않으며 비우면 제거됩니다. 평단은 시세가 아닌 예시값입니다.
# 입력 가능: 빈 문자열 또는 코드,이름,수량,평단을 종목별 세미콜론으로 구분. 코드는 중복 없는 6자리 숫자, 이름 필수, 수량은 양의 정수, 평단은 양수. 예: 000660,SK하이닉스,10,200000.
PREVIEW_EXTRA_HOLDINGS=000660,SK하이닉스,10,200000;035420,NAVER,10,200000;005380,현대차,10,250000;000270,기아,10,100000;051910,LG화학,10,300000;006400,삼성SDI,10,250000;068270,셀트리온,10,180000;035720,카카오,10,50000;105560,KB금융,10,90000

# 프로그램 밖에서 먼저 수집한 1년 KIS 일봉·검증·스냅샷의 단일 파일 경로입니다.
KIS_HISTORY_BUNDLE_PATH=rmmt/data/kis_history.sqlite

# 매 거래일 전체 일봉 증분 갱신 시작 시각(KST, HH:MM). REVERSE_EXECUTION_TIME보다 빨라야 합니다.
# 예: 07:30. 값을 변경한 뒤 프로그램을 재시작하면 적용됩니다.
DAILY_COLLECTION_TIME=08:00
